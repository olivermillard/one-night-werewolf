# Public Supabase project URL (this project's URL is already filled in).
NEXT_PUBLIC_SUPABASE_URL=https://gdtbovckkxgeexexfgak.supabase.co

# Publishable / anon key from Supabase → Project Settings → API.
# Safe to expose to the browser. It cannot read hidden roles because of RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key from Supabase → Project Settings → API.
# Server-only. Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
